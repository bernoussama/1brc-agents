{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Allowlist for an Astro 7 + pnpm project. Swap pnpm for your package manager and drop scripts your package.json doesn't have. ':*' is a prefix match.",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm run dev)",
      "Bash(pnpm build)",
      "Bash(pnpm run build)",
      "Bash(pnpm preview)",
      "Bash(pnpm run preview)",
      "Bash(pnpm lint)",
      "Bash(pnpm run lint)",
      "Bash(pnpm check)",
      "Bash(pnpm run check)",
      "Bash(pnpm test)",
      "Bash(pnpm run test)",
      "Bash(pnpm format)",
      "Bash(pnpm run format)",
      "Bash(pnpm astro:*)",
      "Bash(pnpm run astro:*)",
      "Bash(pnpm exec astro:*)",
      "Bash(npx astro:*)"
    ],
    "ask": [],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)"]
  }
}
