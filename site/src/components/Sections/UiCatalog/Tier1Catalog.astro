---
// src/components/UiCatalog/Tier1Catalog.astro — DEV-ONLY. The "Tier 1" section of the UI catalog
// (static primitives: Button, Badge, Input/Label, Textarea, Card, Alert, Separator, Skeleton,
// Avatar), extracted from UiCatalog.astro so each tier owns its own demo data + markup instead of
// enlarging the catalog monolith. Rendered by UiCatalog; 404s out of prod with it. Emits a run of
// top-level <section>/<Separator> nodes so it slots into the catalog's flex-col-gap-14 flow unchanged.
import { Icon } from "@components/svg/icons";
import Alert from "@components/ui/alert";
import Avatar from "@components/ui/avatar";
import Badge from "@components/ui/badge";
import Button from "@components/ui/button";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardImage,
  CardTitle,
} from "@components/ui/card";
import Input from "@components/ui/input";
import Label from "@components/ui/label";
import Separator from "@components/ui/separator";
import Skeleton from "@components/ui/skeleton";
import Textarea from "@components/ui/textarea";

const sizes = ["sm", "md", "lg"] as const;
const states = ["default", "error", "success"] as const;
const buttonVariants = ["primary", "secondary", "outline", "ghost"] as const;
const badgeVariants = [
  "primary",
  "secondary",
  "muted",
  "outline",
  "info",
  "success",
  "warning",
  "error",
] as const;
const alertVariants = ["info", "success", "warning", "error"] as const;
---

{/* Button */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Button</h2>
  {
    sizes.map((size) => (
      <div class="flex flex-wrap items-center gap-3">
        {buttonVariants.map((variant) => (
          <Button variant={variant} size={size}>
            {variant} {size}
          </Button>
        ))}
        <Button variant="primary" size={size} disabled>
          disabled
        </Button>
      </div>
    ))
  }
  <div class="flex flex-wrap items-center gap-3">
    <Button href="#button" variant="primary">Link (renders &lt;a&gt;)</Button>
    <Button href="#button" variant="outline">Outline link</Button>
  </div>
  {/* With an icon — the base `gap-2` spaces a leading/trailing <Icon> from the label. */}
  <div class="flex flex-wrap items-center gap-3">
    <Button variant="primary"><Icon name="plus-01" size="sm" />New item</Button>
    <Button variant="secondary"><Icon name="download-01" size="sm" />Download</Button>
    <Button variant="outline">Continue<Icon name="arrow-right" size="sm" /></Button>
  </div>
  {/* Icon-only (square) — `icon` drops the horizontal padding; always give it an aria-label. */}
  <div class="flex flex-wrap items-center gap-3">
    {
      sizes.map((size) => (
        <Button icon size={size} variant="outline" aria-label={`Search (${size})`}>
          <Icon name="search-01" size="sm" />
        </Button>
      ))
    }
    <Button icon variant="ghost" aria-label="Settings">
      <Icon name="settings" size="sm" />
    </Button>
    <Button icon variant="primary" disabled aria-label="Delete (disabled)">
      <Icon name="trash-01" size="sm" />
    </Button>
  </div>
</section>

<Separator />

{/* Badge */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Badge</h2>
  <div class="flex flex-wrap items-center gap-2">
    {badgeVariants.map((variant) => <Badge variant={variant}>{variant}</Badge>)}
  </div>
</section>

<Separator />

{/* Input + Label + field composition */}
<section class="flex flex-col gap-6">
  <h2 class="h3">Input &amp; Label</h2>
  <div class="grid gap-6 sm:grid-cols-3">
    {
      states.map((state) => (
        <div class="flex flex-col gap-4">
          {sizes.map((size) => (
            <div class="flex flex-col gap-2">
              <Label for={`in-${state}-${size}`}>
                {state}/{size}
              </Label>
              <Input
                id={`in-${state}-${size}`}
                size={size}
                state={state}
                placeholder="you@example.com"
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>
  <div class="flex flex-col gap-2">
    <Input placeholder="disabled" disabled />
  </div>
  {/* Accessible error field: aria-invalid + aria-describedby announces the message */}
  <div class="flex max-w-sm flex-col gap-2">
    <Label for="email">Email</Label>
    <Input
      id="email"
      type="email"
      state="error"
      required
      aria-invalid="true"
      aria-describedby="email-error"
      placeholder="you@example.com"
    />
    <p id="email-error" class="text-error text-sm">Please enter a valid email address.</p>
  </div>
</section>

<Separator />

{/* Textarea */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Textarea</h2>
  <div class="grid gap-4 sm:grid-cols-3">
    {states.map((state) => <Textarea state={state} placeholder={`${state} textarea`} />)}
  </div>
</section>

<Separator />

{/* Card */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Card</h2>

  {/* Compound: title + description + a top-right action, then content + footer */}
  <Card class="max-w-sm">
    <CardHeader>
      <CardTitle>Card title</CardTitle>
      <CardDescription>A compound card: header, content, footer.</CardDescription>
      <CardAction>
        <Button size="sm" variant="ghost" aria-label="Card options">⋯</Button>
      </CardAction>
    </CardHeader>
    <CardContent>
      <p class="text-sm">
        Body content sits in <code>CardContent</code>. Tokens flip with the theme.
      </p>
    </CardContent>
    <CardFooter class="gap-2">
      <Button size="sm">Save</Button>
      <Button size="sm" variant="ghost">Cancel</Button>
    </CardFooter>
  </Card>

  {/* variant — elevation + hover treatment */}
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      (["default", "elevated", "outline", "interactive"] as const).map((variant) => (
        <Card variant={variant}>
          <CardHeader>
            <CardTitle class="capitalize">{variant}</CardTitle>
            <CardDescription>variant="{variant}"</CardDescription>
          </CardHeader>
          <CardContent>
            <p class="text-sm">Same markup, different elevation.</p>
          </CardContent>
        </Card>
      ))
    }
  </div>

  {/* size — one knob repads every part */}
  <div class="grid items-start gap-4 sm:grid-cols-3">
    {
      (["sm", "md", "lg"] as const).map((size) => (
        <Card size={size}>
          <CardHeader>
            <CardTitle>Size {size}</CardTitle>
            <CardDescription>size="{size}"</CardDescription>
          </CardHeader>
          <CardContent>
            <p class="text-sm">Retunes header / content / footer padding at once.</p>
          </CardContent>
        </Card>
      ))
    }
  </div>

  <div class="grid items-start gap-4 lg:grid-cols-2">
    {/* Media card — CardImage clips to the card radius */}
    <Card class="max-w-sm">
      <CardImage src="https://picsum.photos/seed/astro-boiler/640/360" alt="" />
      <CardHeader>
        <CardTitle>Media card</CardTitle>
        <CardDescription>overflow-hidden on the root rounds the image corners.</CardDescription>
      </CardHeader>
      <CardContent>
        <p class="text-sm">Top, bottom, or full-bleed — all just work.</p>
      </CardContent>
    </Card>

    {/* Blog card + author, hoverable */}
    <Card variant="interactive" class="max-w-sm">
      <CardImage src="https://picsum.photos/seed/blog/640/360" alt="" />
      <CardHeader>
        <CardTitle>Shipping a token-driven UI</CardTitle>
        <CardDescription>
          How the palette → semantic → utility bridge keeps dark mode free.
        </CardDescription>
      </CardHeader>
      <CardFooter class="gap-3">
        <Avatar size="sm" src="https://i.pravatar.cc/64" alt="Post author" />
        <div class="text-sm">
          <p class="font-medium">Jane Doe</p>
          <p class="text-muted-foreground">Jul 1, 2026 · 4 min read</p>
        </div>
      </CardFooter>
    </Card>
  </div>

  {/* Horizontal — just sm:flex-row on the root */}
  <Card class="max-w-lg sm:flex-row">
    <CardImage
      src="https://picsum.photos/seed/horizontal/480/480"
      alt=""
      class="sm:w-40 sm:shrink-0"
    />
    <div class="flex flex-1 flex-col">
      <CardHeader>
        <CardTitle>Horizontal layout</CardTitle>
        <CardDescription>Image beside content on ≥sm.</CardDescription>
      </CardHeader>
      <CardContent>
        <p class="text-sm">The image stretches to the card's height.</p>
      </CardContent>
    </div>
  </Card>

  {/* Top-bordered status accent — a one-off class, not a new variant */}
  <Card class="border-t-primary max-w-sm border-t-4">
    <CardHeader>
      <CardTitle>Top-bordered accent</CardTitle>
      <CardDescription>A status stripe is one class (border-t-4 border-t-primary).</CardDescription>
    </CardHeader>
    <CardContent>
      <p class="text-sm">No primitive change needed for a one-off.</p>
    </CardContent>
  </Card>
</section>

<Separator />

{/* Alert */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Alert</h2>
  {
    alertVariants.map((variant) => (
      <Alert variant={variant}>
        <span class="font-medium capitalize">{variant}:</span>
        <span>This is a {variant} alert message.</span>
      </Alert>
    ))
  }
</section>

<Separator />

{/* Separator (vertical) */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Separator</h2>
  <div class="flex h-6 items-center gap-3 text-sm">
    <span>Home</span>
    <Separator orientation="vertical" />
    <span>Docs</span>
    <Separator orientation="vertical" />
    <span>About</span>
  </div>
</section>

<Separator />

{/* Skeleton */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Skeleton</h2>
  <div class="flex items-center gap-4">
    <Skeleton class="size-12 rounded-full" />
    <div class="flex flex-col gap-2">
      <Skeleton class="h-4 w-48" />
      <Skeleton class="h-4 w-32" />
    </div>
  </div>
</section>

<Separator />

{/* Avatar */}
<section class="flex flex-col gap-4">
  <h2 class="h3">Avatar</h2>
  <div class="flex items-center gap-4">
    {sizes.map((size) => <Avatar size={size} src="https://i.pravatar.cc/96" alt="Sample user" />)}
    {sizes.map((size) => <Avatar size={size}>AB</Avatar>)}
  </div>
</section>
