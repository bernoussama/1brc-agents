---
// src/components/Sections/Home/FeaturedProjects.astro — Figma "Featured Projects Section" (node 14:34).
//
// Data-only section: the shared heading + 1/2/3-col card grid live in <CardGrid>. The cards are now
// read from the `projects` collection (the first three by `order`, drafts dropped) and mapped through
// the shared `toProjectCard`, so the home grid, the /projects/ grid, and the detail routes all share
// one source — no more hand-kept demo list with slugs that 404. Each card links to its real
// /projects/<slug>/ detail page.
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import { toProjectCard } from "@js/projectCards";
import { getSortedProjects } from "@js/projectData";

const featured = (await getSortedProjects()).slice(0, 3).map(toProjectCard);
---

<CardGrid headingId="featured-projects-heading" title="Featured Projects" items={featured} />
