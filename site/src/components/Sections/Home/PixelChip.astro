---
// src/components/Sections/Home/PixelChip.astro
//
// The Figma "Stack Badge" / "Social" chip (nodes 14:10, 14:151): a pixel-bordered card box with a
// small line icon + a bold uppercase Space Mono label. Two consumers, one shell:
//   • Tech Stack — static labels (no `href`) → renders a <span>.
//   • Contact socials — links (`href` present) → renders an <a> that goes green on hover, the house
//     active/hover colour (same as the nav / footer).
// Icons come from the pixel `svg/pixel-icons` registry (crisp-edges, fill = currentColor). Tokens only.
import { PixelIcon, type PixelIconName } from "@components/svg/pixel-icons";
import { PixelPanel } from "@components/ui/pixel-panel";
import type { HTMLAttributes } from "astro/types";

interface Props {
  icon: PixelIconName;
  label: string;
  /** When set, the chip is a link (Contact socials); otherwise a static span (Tech Stack). */
  href?: string;
  /** Accessible name when the visible label isn't enough (e.g. "Twitter/X profile"). */
  ariaLabel?: string;
  external?: boolean;
}
const { icon, label, href, ariaLabel, external } = Astro.props as Props;

const Tag = href ? "a" : "span";
const attrs: HTMLAttributes<"a"> = href
  ? {
      href,
      "aria-label": ariaLabel ?? label,
      ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}),
    }
  : {};

// The pixel surface (frame + offset shadow, both themes) comes from ui/pixel-panel; the chip adds
// only its inline layout and, on links, the green house hover colour.
const interactive = href
  ? "primary-focus hover:text-success motion-reduce:transition-none transition-colors"
  : "";
const chipClass = ["inline-flex items-center gap-2 px-3 py-2", interactive]
  .filter(Boolean)
  .join(" ");
---

<PixelPanel as={Tag} class={chipClass} data-slot="pixel-chip" {...attrs}>
  <PixelIcon name={icon} class="size-[18px]" />
  <span class="text-sm font-bold uppercase">{label}</span>
</PixelPanel>
