import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
---

<HeroPanel
  headingId="projects-hero-heading"
  tagline="Mission Archive"
  heading="Project Log"
  intro="Quest archive — all developer operations, full-stack pipelines, and vintage terminal prototypes thoroughly cataloged and documented. Press view to inspect the source modules."
/>
