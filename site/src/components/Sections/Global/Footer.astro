---
// src/components/Sections/Global/Footer.astro — the global site footer (8-BitQuest, Figma node 5:93).
//
// Cross-page chrome, rendered once in BaseLayout below <main>. Reproduces the dark Figma frame: a
// full-bleed pixel bar (black top border, no shadow) with three groups — copyright (left), a
// social/utility icon row (centre), legal links (right). One desktop frame, so it stacks to a
// centred column below `md` (measured: the three Press Start groups stop fitting comfortably under
// ~768px). Tokens only, so the light theme (lavender ground / navy ink) flips for free.
//
// Reuses what's here — the pixel-icon registry (`svg/pixel-icons`) for the four social glyphs, and
// `.site-container` / `.primary-focus` from global.css. No new primitives beyond that registry, no JS.
// Icons rest **blue in light** (`text-info`) / **pink in dark** (`dark:text-secondary`) and go green
// (`hover:text-success`) on hover — the same active/hover colour as the nav.
//
// Wiring (decisions the single mock didn't specify):
//   - copyright year is build-time; "GAME OVER" is kept retro flavour, not the site name.
//   - Privacy/Terms are the real legal routes.
//   - the two external social destinations resolve through `@config/socialData` (label + glyph + the
//     sameAs derivation, defined once); RSS and email are site-local, so they stay literal here.
import { PixelIcon, type PixelIconName } from "@components/svg/pixel-icons";
import siteData from "@config/siteData.json";
import { socialLink } from "@config/socialData.json";

const year = new Date().getFullYear();
const copyright = `© ${year} — Game Over`;

// Social row (Figma 5:96, glyphs swapped to the pixel set). `name` is validated against the
// pixel-icon registry. Which platforms appear is this section's call; how one resolves is not.
type SocialLink = { name: PixelIconName; label: string; href: string; external?: boolean };
const socialLinks: readonly SocialLink[] = [
  { ...socialLink("linkedin"), external: true },
  { name: "rss", label: "RSS feed", href: "/rss.xml" },
  { ...socialLink("youtube"), external: true },
  { name: "email", label: "Email", href: `mailto:${siteData.author.email}` },
];

// Legal row (Figma 5:103). Trailing slashes match astro.config `trailingSlash: "always"`.
const legalLinks = [
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" },
] as const;
---

<footer class="bg-background border-border border-t-4" data-slot="site-footer">
  <div
    class="site-container flex flex-col items-center gap-4 py-4 text-center md:flex-row md:justify-between md:gap-6 md:text-left"
  >
    <!-- Copyright (Figma 5:94): airy-blue Press Start 2P, uppercased. -->
    <p class="font-display text-info text-xs uppercase">{copyright}</p>

    <!-- Social icons (Figma 5:96): pixel glyphs, blue in light / pink in dark → green on hover. -->
    <ul class="flex items-center gap-4">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-label={link.label}
              class="primary-focus text-info dark:text-secondary hover:text-success block transition-colors"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <PixelIcon name={link.name} class="h-5" />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Legal links (Figma 5:103): tiny grey Press Start 2P → green on hover. -->
    <nav aria-label="Legal">
      <ul class="flex items-center gap-4">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="primary-focus text-muted-foreground hover:text-success font-display text-[8px] tracking-[2px] uppercase transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
