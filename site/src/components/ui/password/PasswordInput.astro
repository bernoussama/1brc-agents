---
// src/components/ui/password/PasswordInput.astro — astro-boiler primitive (see ../README.md).
// A password field with a show/hide toggle. Reuses the `input` config (ladder rung 2). The small
// script flips the field `type` between password/text and keeps the button's `aria-pressed` /
// `aria-label` accurate; the eye / eye-off icons swap with a CSS `hidden` toggle. Without JS it stays
// a plain, fully-usable password field (the button is simply inert). Give it a name via `id`/`name`.
import { input } from "@components/ui/input/Input.astro";
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"input"> & VariantProps<typeof input>;

const { size, state, class: className, ...rest } = Astro.props;
---

<div class="relative" data-slot="password-input">
  <input
    type="password"
    autocomplete="current-password"
    data-slot="password-field"
    class={input({ size, state, class: ["pr-10", className] })}
    {...rest}
  />
  <button
    type="button"
    data-slot="password-toggle"
    aria-pressed="false"
    aria-label="Show password"
    class="text-muted-foreground hover:text-foreground focus-visible:ring-outline absolute inset-y-0 right-0 grid w-10 place-items-center rounded-md outline-none focus-visible:ring-3"
  >
    <svg
      data-slot="eye"
      class="size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <svg
      data-slot="eye-off"
      class="hidden size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9.88 9.88a3 3 0 0 0 4.24 4.24"></path>
      <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
      <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
      <line x1="2" x2="22" y1="2" y2="22"></line>
    </svg>
  </button>
</div>

<script>
  import { onReady } from "../_client";

  function wire(root: HTMLElement) {
    const field = root.querySelector<HTMLInputElement>('[data-slot="password-field"]');
    const btn = root.querySelector<HTMLButtonElement>('[data-slot="password-toggle"]');
    if (!field || !btn) return;
    btn.addEventListener("click", () => {
      const shown = field.type === "text";
      field.type = shown ? "password" : "text";
      btn.setAttribute("aria-pressed", String(!shown));
      btn.setAttribute("aria-label", shown ? "Show password" : "Hide password");
      root.querySelector('[data-slot="eye"]')?.classList.toggle("hidden", !shown);
      root.querySelector('[data-slot="eye-off"]')?.classList.toggle("hidden", shown);
    });
  }
  onReady('[data-slot="password-input"]', wire);
</script>
