---
// src/components/ui/password/PasswordStrength.astro — astro-boiler primitive (see ../README.md).
// A 4-segment strength meter + a live label, driven by the rule-based `scorePassword` (strength.ts).
// It watches the paired field (`for` = the input's id, mirroring <label for>), scores on every input,
// and paints N segments with the status token. The label sits in an aria-live region so screen
// readers announce changes. Without JS the bar renders empty with a neutral hint — no error.
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof passwordStrength> & { for: string };

export const passwordStrength = tv({
  base: ["flex flex-col gap-2"],
  variants: { size: { sm: "[--seg-h:0.25rem]", md: "[--seg-h:0.375rem]" } },
  defaultVariants: { size: "md" },
});

const { for: target, size, class: className, ...rest } = Astro.props;
---

<div
  class={passwordStrength({ size, class: className })}
  data-slot="password-strength"
  data-for={target}
  {...rest}
>
  <div class="flex gap-1" aria-hidden="true">
    {
      [0, 1, 2, 3].map(() => (
        <div
          class="bg-muted h-[var(--seg-h)] flex-1 rounded-full transition-colors"
          data-slot="password-strength-segment"
        />
      ))
    }
  </div>
  <p class="text-muted-foreground text-sm" data-slot="password-strength-label" aria-live="polite">
    Enter a password
  </p>
</div>

<script>
  import { onReady } from "../_client";
  import { scorePassword } from "./strength";

  const TONE = ["bg-error", "bg-warning", "bg-warning", "bg-success"] as const; // score 1..4
  const LABEL = ["Enter a password", "Weak", "Fair", "Good", "Strong"] as const; // score 0..4
  const TONES = [...new Set(TONE), "bg-muted"]; // every class paint() might set, to clear first

  function wire(root: HTMLElement) {
    const field = document.getElementById(root.dataset.for ?? "");
    if (!(field instanceof HTMLInputElement)) return;
    const segs = [...root.querySelectorAll<HTMLElement>('[data-slot="password-strength-segment"]')];
    const label = root.querySelector<HTMLElement>('[data-slot="password-strength-label"]');

    const paint = () => {
      const score = scorePassword(field.value);
      segs.forEach((seg, i) => {
        seg.classList.remove(...TONES);
        seg.classList.add(score > 0 && i < score ? TONE[score - 1] : "bg-muted");
      });
      if (label) label.textContent = LABEL[score];
    };

    field.addEventListener("input", paint);
    paint();
  }

  onReady('[data-slot="password-strength"]', wire);
</script>
