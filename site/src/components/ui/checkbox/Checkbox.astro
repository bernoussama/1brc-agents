---
// src/components/ui/checkbox/Checkbox.astro — astro-boiler primitive (see ../README.md).
// Native <input type=checkbox>, `appearance-none` and styled with `peer` + `:checked`. The check icon
// is a sibling SVG revealed on `peer-checked`. Associate a Label via `id`/`for`. Zero-JS. Tokens only.
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"input"> & VariantProps<typeof checkbox>;

export const checkbox = tv({
  base: [
    "peer size-4 shrink-0 appearance-none rounded-sm border bg-transparent shadow-xs outline-none",
    "border-input checked:border-primary checked:bg-primary",
    "transition-[color,box-shadow] focus-visible:ring-3 focus-visible:ring-outline",
    "disabled:cursor-not-allowed disabled:opacity-50",
  ],
});

const { class: className, ...rest } = Astro.props;
---

<span class="relative inline-flex" data-slot="checkbox-root">
  <input type="checkbox" class={checkbox({ class: className })} data-slot="checkbox" {...rest} />
  <svg
    class="text-primary-foreground pointer-events-none absolute inset-0 m-auto size-3 opacity-0 peer-checked:opacity-100"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
</span>
