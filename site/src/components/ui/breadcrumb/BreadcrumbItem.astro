---
// src/components/ui/breadcrumb/BreadcrumbItem.astro — Breadcrumb compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"li"> & VariantProps<typeof breadcrumbItem>;

export const breadcrumbItem = tv({
  base: ["inline-flex items-center gap-1.5"],
});

const { class: className, ...rest } = Astro.props;
---

<li class={breadcrumbItem({ class: className })} data-slot="breadcrumb-item" {...rest}>
  <slot />
</li>
