---
// src/components/ui/tabs/TabsList.astro — Tabs compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof tabsList>;

export const tabsList = tv({
  base: ["border-border inline-flex items-center gap-1 border-b"],
});

const { class: className, ...rest } = Astro.props;
---

<div class={tabsList({ class: className })} role="tablist" data-slot="tabs-list" {...rest}>
  <slot />
</div>
