---
// src/components/ui/accordion/AccordionContent.astro — Accordion compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof accordionContent>;

export const accordionContent = tv({
  base: ["text-muted-foreground pb-4 text-sm"],
});

const { class: className, ...rest } = Astro.props;
---

<div class={accordionContent({ class: className })} data-slot="accordion-content" {...rest}>
  <slot />
</div>
