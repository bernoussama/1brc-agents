---
// src/components/ui/card/CardContent.astro — Card compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof cardContent>;

export const cardContent = tv({
  base: ["p-[var(--card-p,1.5rem)] pt-0"],
});

const { class: className, ...rest } = Astro.props;
---

<div class={cardContent({ class: className })} data-slot="card-content" {...rest}><slot /></div>
