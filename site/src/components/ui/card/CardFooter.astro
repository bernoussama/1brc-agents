---
// src/components/ui/card/CardFooter.astro — Card compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof cardFooter>;

export const cardFooter = tv({
  base: ["flex items-center p-[var(--card-p,1.5rem)] pt-0"],
});

const { class: className, ...rest } = Astro.props;
---

<div class={cardFooter({ class: className })} data-slot="card-footer" {...rest}><slot /></div>
