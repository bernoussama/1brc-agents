---
// src/components/ui/avatar/Avatar.astro — astro-boiler primitive (see ../README.md).
// <img> when `src` is set, else the slot (fallback initials). Sized via `size`. Tokens only.
//
// `src` takes a bundled `ImageMetadata` (from astro:assets / `image()`) or a plain URL string. A
// bundled image carries intrinsic width/height, which we emit to kill layout shift; a string has none.
// `alt` is REQUIRED whenever `src` is set — explicit intent, no silent "" default (pass alt="" only to
// mark it decorative on purpose). `loading` / `decoding` are forwarded so a below-the-fold avatar can
// lazy-load. Note: this is a plain <img> (no Sharp), so a bundled ImageMetadata is used at its own size.
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"span"> &
  VariantProps<typeof avatar> & {
    src?: ImageMetadata | string;
    /** Required when `src` is set (use alt="" for a purely decorative image). */
    alt?: string;
    loading?: "eager" | "lazy";
    decoding?: "sync" | "async" | "auto";
  };

export const avatar = tv({
  base: [
    "relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full",
    "bg-muted text-muted-foreground font-medium select-none",
  ],
  variants: {
    size: { sm: "size-8 text-xs", md: "size-10 text-sm", lg: "size-12 text-base" },
  },
  defaultVariants: { size: "md" },
});

const {
  size,
  src,
  alt,
  loading = "lazy",
  decoding = "async",
  class: className,
  ...rest
} = Astro.props;

// Trust boundary: an image with no alt intent is an accessibility defect, so fail the build rather
// than silently default it.
if (src !== undefined && alt === undefined) {
  throw new Error(
    'Avatar: `alt` is required when `src` is set (use alt="" for a decorative image).',
  );
}

// Normalize to { src, width?, height? } — a bundled ImageMetadata already has the dims; a URL string doesn't.
const image: { src: string; width?: number; height?: number } | undefined =
  src === undefined ? undefined : typeof src === "string" ? { src } : src;
---

<span class={avatar({ size, class: className })} data-slot="avatar" {...rest}>
  {
    image ? (
      <img
        src={image.src}
        alt={alt}
        width={image.width}
        height={image.height}
        loading={loading}
        decoding={decoding}
        class="size-full object-cover"
      />
    ) : (
      <slot />
    )
  }
</span>
