---
// src/components/ui/pagination/PaginationItem.astro — Pagination compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"li"> & VariantProps<typeof paginationItem>;

export const paginationItem = tv({
  base: ["inline-flex"],
});

const { class: className, ...rest } = Astro.props;
---

<li class={paginationItem({ class: className })} data-slot="pagination-item" {...rest}>
  <slot />
</li>
