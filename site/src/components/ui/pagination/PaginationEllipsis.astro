---
// src/components/ui/pagination/PaginationEllipsis.astro — Pagination compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"span"> & VariantProps<typeof paginationEllipsis>;

export const paginationEllipsis = tv({
  base: ["text-muted-foreground flex size-9 items-center justify-center text-sm"],
});

const { class: className, ...rest } = Astro.props;
---

<span class={paginationEllipsis({ class: className })} data-slot="pagination-ellipsis" {...rest}>
  <span aria-hidden="true">&hellip;</span>
  <span class="sr-only">More pages</span>
</span>
