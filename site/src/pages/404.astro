---
// 404 (served for any unmatched route). Thin route shell: owns BaseLayout + SEO (noindex)
// and the page copy, passed down so the meta tags and the visible text can't drift; the
// markup lives in Sections/NotFound.
import NotFound from "@components/Sections/NotFound/NotFound.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "Page not found";
const description =
  "Sorry, the page you're looking for doesn't exist or has moved. Let's get you back on track.";
---

<BaseLayout title={`${title} — ${siteData.name}`} description={description} noindex={true}>
  <NotFound title={title} description={description} />
</BaseLayout>
