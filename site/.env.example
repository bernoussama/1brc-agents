# Copy to `.env` and fill in. On a host, set the same variables in its build environment
# (Netlify: Site configuration → Environment variables; Vercel: Settings → Environment Variables).

# Your production domain. Feeds canonical + OG URLs, JSON-LD, the sitemap, robots.txt and
# llms.txt — setting it once fixes all of them. Local builds and deploy previews fall back to
# the https://example.com placeholder; a PRODUCTION deploy throws rather than ship it
# (see the gate at the top of astro.config.mjs).
SITE_URL=https://example.com

# Only needed on hosts that aren't Netlify or Vercel, whose own build variables the gate already
# reads. Set this to "production" in your production build environment — and nowhere else, or
# preview deploys will start failing on the placeholder too.
# DEPLOY_ENV=production

# --- Contact form -----------------------------------------------------------------------------
# The /contact/ route is server-rendered and sends through Resend (https://resend.com). Both keys
# below are read at REQUEST time, so leaving them unset never breaks the build — the form answers
# with its generic send-failure message and names the missing key in the server log. Create an API
# key in the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact submissions are delivered — your own inbox.
CONTACT_TO_EMAIL=you@example.com

# Optional. The From address on the sent mail. Defaults to Resend's shared onboarding@resend.dev,
# which ONLY delivers to the Resend account owner's own address (fine for a first smoke test). To
# send to anyone else, verify your own domain in Resend and set a From address on that domain here.
# CONTACT_FROM_EMAIL=hello@yourdomain.com
